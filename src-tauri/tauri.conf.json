{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pliflo",
  "version": "0.1.0",
  "identifier": "app.pliflo.desktop",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": { "enable": true, "scope": ["**/*.pdf"] },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Pliflo",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "icon": [] }
}
